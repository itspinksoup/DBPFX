// Generated by CMake from native/cmake/identity.rc.in - do not edit.
// DBPFX.Identity.dll: resource-only library holding the icon of every release channel. Executables
// get their icon from here at build time (dbpfx-iconstamp copies the group named after the channel).
#include <winver.h>

STABLE    ICON "@DBPFX_ICON_DIR@/STABLE_DBPFX.ico"
BETA      ICON "@DBPFX_ICON_DIR@/BETA_DBPFX.ico"
CANARY    ICON "@DBPFX_ICON_DIR@/CANARY_DBPFX.ico"
DEVELOPER ICON "@DBPFX_ICON_DIR@/DEVELOPER_DBPFX.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       @DBPFX_RC_FLAGS@
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "DBPFX identity (channel icons)"
            VALUE "FileVersion",      "@DBPFX_VERSION_STRING@"
            VALUE "InternalName",     "DBPFX.Identity"
            VALUE "OriginalFilename", "DBPFX.Identity.dll"
            VALUE "ProductName",      "DBPFX"
            VALUE "ProductVersion",   "@DBPFX_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

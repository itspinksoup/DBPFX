<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>DBPFX</RootNamespace>
    <AssemblyName>DBPFX</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable Condition="'$(TargetFramework)' == 'net10.0'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Ship the native engine with the assembly (and in the NuGet package under runtimes/<rid>/native). -->
  <ItemGroup>
    <None Include="$(DbpfxNativeDir)DBPFX.Native.dll" Condition="Exists('$(DbpfxNativeDir)DBPFX.Native.dll')"
          Link="DBPFX.Native.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(DbpfxNativeDir)libDBPFX.Native.so" Condition="Exists('$(DbpfxNativeDir)libDBPFX.Native.so')"
          Link="libDBPFX.Native.so" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(DbpfxNativeDir)libDBPFX.Native.dylib" Condition="Exists('$(DbpfxNativeDir)libDBPFX.Native.dylib')"
          Link="libDBPFX.Native.dylib" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

</Project>
